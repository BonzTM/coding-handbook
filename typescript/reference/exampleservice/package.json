{
  "name": "typescript-exampleservice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "jest --maxWorkers=2",
    "test:integration": "RUN_INTEGRATION=1 jest --config jest.integration.config.cjs --maxWorkers=1",
    "audit": "npm audit --audit-level=high",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/main.js",
    "migrate": "node-pg-migrate up --migrations-dir src/db/migrations --migration-file-language sql --check-order",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run audit && npm run build"
  },
  "dependencies": {
    "fastify": "5.11.3",
    "fastify-type-provider-zod": "6.1.0",
    "node-pg-migrate": "9.0.0",
    "pg": "8.22.0",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@eslint/js": "10.0.1",
    "@jest/globals": "30.4.1",
    "@testcontainers/postgresql": "12.0.4",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "babel-jest": "30.4.1",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.7.0",
    "jest": "30.4.2",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  }
}
