# Destination: .env.example. Safe examples only; never put a real secret here.
APP_ENV=local
LOG_LEVEL=INFO
LOG_JSON=false
HTTP_HOST=127.0.0.1
HTTP_PORT=8080
SHUTDOWN_GRACE_SECONDS=15
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/<app>
OUTBOUND_BASE_URL=https://api.example.invalid
OUTBOUND_TIMEOUT_SECONDS=10
<REQUIRED_NON_SECRET_KEY>=<safe-example>
