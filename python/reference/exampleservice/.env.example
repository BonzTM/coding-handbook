APP_ENV=local
LOG_LEVEL=INFO
LOG_JSON=false
HTTP_HOST=127.0.0.1
HTTP_PORT=8080
HTTP_CONCURRENCY=100
HTTP_KEEP_ALIVE_SECONDS=5
REQUEST_TIMEOUT_SECONDS=5
